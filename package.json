{
  "name": "@knowttl/kubernetes-axi",
  "version": "0.1.0",
  "description": "Agent-facing Kubernetes CLI backed by pinned kubectl",
  "repository": { "type": "git", "url": "git+https://github.com/knowttl/kubernetes-axi.git" },
  "type": "module",
  "engines": { "node": "24.14.0", "npm": "11.9.0" },
  "packageManager": "npm@11.9.0",
  "publishConfig": { "access": "public" },
  "bin": { "kubernetes-axi": "bin/kubernetes-axi.js" },
  "files": ["bin", "dist", "vendor", "third-party", "THIRD_PARTY_NOTICES.md", "axi-credential.schema.json", "kubectl-pins.json", "command-metadata.json", "skills", "docs/hooks.md"],
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/check-binaries.mjs && tsc",
    "lint": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.verify.json",
    "test": "unshare --user --map-root-user --net -- sh -c 'ip link set lo up && GOPROXY=off node scripts/generate-metadata.ts --check && GOPROXY=off node scripts/generate-protobuf.ts --check && python3 scripts/verify.py task B1.1 --mode offline --pack evidence && node test/private-files.ts && node test/b2.ts && node test/package-contract.ts'",
    "generate:metadata": "node scripts/generate-metadata.ts",
    "check:metadata": "GOPROXY=off node scripts/generate-metadata.ts --check",
    "check": "npm run lint && npm test"
  },
  "dependencies": { "@toon-format/toon": "4.4.0", "@types/node": "24.10.0", "ajv": "8.17.1", "protobufjs": "7.6.6" },
  "devDependencies": { "typescript": "5.9.3" }
}
