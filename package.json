{
  "name": "@knowttl/kubernetes-axi",
  "version": "0.1.0",
  "description": "Agent-facing Kubernetes CLI backed by pinned kubectl",
  "type": "module",
  "engines": { "node": "24.14.0", "npm": "11.9.0" },
  "packageManager": "npm@11.9.0",
  "bin": { "kubernetes-axi": "bin/kubernetes-axi.js" },
  "files": ["bin", "dist", "vendor", "third-party", "THIRD_PARTY_NOTICES.md", "axi-credential.schema.json", "kubectl-pins.json"],
  "scripts": {
    "prepare": "npm run build",
    "build": "node scripts/check-binaries.mjs && tsc",
    "lint": "tsc --noEmit",
    "test": "python3 scripts/verify.py task B1.1 --mode offline --pack evidence",
    "check": "npm run lint && npm test"
  },
  "dependencies": { "@toon-format/toon": "4.4.0", "ajv": "8.17.1" },
  "devDependencies": { "@types/node": "24.10.0", "typescript": "5.9.3" }
}
